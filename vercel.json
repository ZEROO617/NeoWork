{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "vercel-public",
  "framework": null,
  "functions": {"api/proxy.js": {"maxDuration": 60}},
  "rewrites": [{"source": "/api/:path*", "destination": "/api/proxy?route=:path*"}],
  "redirects": [
    {"source": "/settings", "destination": "https://neowork-team-space.gthunder0601.chatgpt.site/settings", "permanent": false},
    {"source": "/settings.html", "destination": "https://neowork-team-space.gthunder0601.chatgpt.site/settings", "permanent": false}
  ],
  "headers": [{"source": "/(.*)", "headers": [
    {"key": "X-Content-Type-Options", "value": "nosniff"},
    {"key": "Referrer-Policy", "value": "same-origin"},
    {"key": "Cache-Control", "value": "no-cache"}
  ]}]
}
